<header class="topo">

  <!-- Voltar -->
  <button
    type="button"
    class="topo-btn btn-voltar"
    onclick="history.back()"
    aria-label="Voltar"
  >
    ←
  </button>

  <!-- Logo -->
  <img
    src="/imagesNino/logo_sem_fundo.png"
    alt="Logo Nino"
    class="topo-logo"
  >

  <!-- Menu -->
  <button
    type="button"
    class="topo-btn btn-menu"
    id="btnMenu"
    aria-label="Abrir menu"
  >
    ☰
  </button>

</header>


<!-- MENU LATERAL -->

<div class="menu-overlay" id="menuOverlay"></div>

<nav class="menu-lateral" id="menuLateral">

  <div class="menu-cabecalho">

    <span>Menu</span>

    <button
      type="button"
      id="btnFecharMenu"
      aria-label="Fechar menu"
    >
      ×
    </button>

  </div>


  <div class="menu-opcoes">

    <a href="/" class="menu-item">
      <span>🏠</span>
      <span>Início</span>
    </a>

    <a href="/registro" class="menu-item">
      <span>💚</span>
      <span>Registro</span>
    </a>

    <a href="/calendario" class="menu-item">
      <span>📅</span>
      <span>Calendário</span>
    </a>

    <a href="/conforto" class="menu-item">
      <span>🌿</span>
      <span>Conforto</span>
    </a>

    <a href="/grafico" class="menu-item">
      <span>📊</span>
      <span>Gráfico</span>
    </a>

    <a href="/membros" class="menu-item">
      <span>👥</span>
      <span>Membros</span>
    </a>

  </div>

</nav>