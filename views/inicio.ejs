
<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Nino</title>

  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      background: linear-gradient(
        to bottom right,
        #E8F5E9,
        #CBEED0,
        #AEE3B7,
        #9ADBA8,
        #88D19D
      );
      font-family: 'Cinzel Decorative', serif;
    }

    .welcome-container {
      width: 100%;
      max-width: 500px;
      text-align: center;
      color: #33691E;
      animation: fadeIn 1.5s ease-in-out;
    }

    .logo {
      width: 40%;
      max-width: 200px;
      height: auto;
      margin-bottom: 10px;
    }

    h1 {
      font-size: 3rem;
      margin-bottom: 15px;
    }

    p {
      font-size: 1.1rem;
      font-style: italic;
      color: #1B5E20;
      margin-bottom: 30px;
    }

    .botoes {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn-nino {
      min-width: 160px;
      background-color: #1B5E20;
      color: white;
      border: 2px solid #1B5E20;
      border-radius: 25px;
      padding: 10px 25px;
      font-size: 1rem;
      transition: 0.3s ease;
      text-decoration: none;
    }

    .btn-nino:hover {
      background-color: #2E7D32;
      border-color: #2E7D32;
      color: white;
      transform: translateY(-2px);
    }

    .btn-secundario {
      background-color: transparent;
      color: #1B5E20;
    }

    .btn-secundario:hover {
      color: white;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 2.3rem;
      }

      p {
        font-size: 1rem;
      }

      .logo {
        width: 45%;
      }

      .botoes {
        flex-direction: column;
        align-items: center;
      }

      .btn-nino {
        width: 100%;
        max-width: 280px;
      }
    }
  </style>
</head>

<body>
  <main class="welcome-container">
    <img
      src="/imagesNino/logo_sem_fundo.png"
      alt="Logo Nino"
      class="logo"
    >

    <h1>Nino</h1>
    <p>Seu conforto do dia.</p>

    <div class="botoes">
      <a href="/login" class="btn-nino">Entrar</a>
      <a href="/cadastro" class="btn-nino btn-secundario">
        Criar conta
      </a>
    </div>
  </main>
</body>
</html>